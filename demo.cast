[0.469875, "o", "ValutaTrade Hub\r\nКоманды:\r\n  register --username <имя> [--password <пароль>] — регистрация\r\n  login --username <имя> [--password <пароль>] — вход\r\n  buy --currency <код> --amount <количество> — купить валюту\r\n  sell --currency <код> --amount <количество> — продать валюту\r\n  --verbose добавляет баланс до и после покупки/продажи в журнал.\r\n  show-portfolio [--base <код>] — кошельки и общая стоимость\r\n  get-rate --from <код> --to <код> — получить курс\r\n  update-rates [--source coingecko|exchangerate] — обновить курсы\r\n  show-rates [--currency <код>] [--top <N>] [--base <код>] — кэш курсов\r\n  --top показывает самые дорогие из отслеживаемых криптовалют.\r\n  whoami — текущий пользователь\r\n  logout — завершить сесс"]
[0.470583, "o", "ию\r\n  help — справка\r\n  exit — выйти\r\nЕсли не указывать --password, пароль вводится отдельно и не отображается.\r\n"]
